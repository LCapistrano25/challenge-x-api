	updated_at timestamptz [ not null ]
	template_id bigint [ not null ]
	user_id bigint [ not null ]
	workload_hours smallint
	verification_code varchar(50) [ not null, unique, note: '(padrão: new_verification_code)' ]
	file_url varchar(1000) [ not null ]
	issued_at timestamptz [ not null, note: '(padrão: now)' ]

	indexes {
		(template_id, user_id) [ unique, name: 'unique_certificate_per_user' ]
	}

	Note: '''certificado (results.Certificate)
CHECK certificate_workload_20_or_40: (workload_hours is null OR workload_hours in [20, 40])'''
}

Table notifications_notification [headercolor: #555555] {
	created_at timestamptz [ not null ]
	updated_at timestamptz [ not null ]
	id uuid [ pk, note: '(padrão: uuid4)' ]
	user_id bigint [ not null ]
	type notifications_notification_type [ not null ]
	title varchar(200) [ not null ]
	message text [ not null ]
	link varchar(500)
	read_at timestamptz

	Note: 'notificação (notifications.Notification)'
}

