DJANGO_SECRET_KEY=replace-with-a-new-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=desafiox
POSTGRES_USER=desafiox
POSTGRES_PASSWORD=replace-with-your-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Login de aluno e professor pela Microsoft (Entra ID > Registros de aplicativo).
# Plataforma "Web" (não SPA): o backend troca o código usando o client secret.
# TENANT_ID é o GUID do diretório da instituição (o da UniCatólica é o de
# login.microsoftonline.com/catolica-to.edu.br/v2.0/.well-known/openid-configuration);
# contas de outro tenant são recusadas. App registrado em outro tenant: multilocatário.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# Certificados e segredos > Novo segredo do cliente (o "Valor", não o ID).
MICROSOFT_CLIENT_SECRET=
# A mesma URI de redirecionamento cadastrada no app e usada pelo frontend
# (ex.: http://localhost:5173/auth/microsoft/callback).
MICROSOFT_REDIRECT_URI=

# Arquivos das entregas (RF31). Fora do repositório e, em produção, num volume
# persistente. O padrão é private_media/ na raiz do projeto.
# DELIVERY_STORAGE_ROOT=
# Teto de tamanho de um arquivo de entrega, em MB (padrão 50).
# DELIVERY_MAX_FILE_MB=50
